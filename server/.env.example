# ── Server ──────────────────────────────────────────────
PORT=4545
JWT_SECRET=change-me-to-a-long-random-string

# ── Database (Turso — hosted SQLite) ─────────────────────
# Get these from app.turso.tech → your database → Connect / Tokens.
# Must be a database-scoped token, not an org-level API token.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=

# ── Email / OTP delivery ──────────────────────────────────
# If neither Resend nor SMTP is configured, OTP codes are printed
# to the server console instead (useful for local dev).

# Preferred for deployed hosts (Render, etc). Sends over HTTPS, so
# it isn't blocked the way raw SMTP ports often are on free hosts.
# Get an API key from resend.com → API Keys.
RESEND_API_KEY=
# Requires verifying your sending domain in Resend first. Until then,
# leave unset — it falls back to Resend's sandbox address, which can
# only email your own Resend account, not real users.
RESEND_FROM="ExpenseTracker" <otp@yourdomain.com>

# Fallback for local dev, or hosts that don't block outbound SMTP.
# Values below work for GoDaddy Workspace Email. For Gmail, use
# smtp.gmail.com / port 587 / an App Password instead of the
# regular account password.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourdomain.com
SMTP_PASS=
SMTP_FROM="ExpenseTracker" <you@yourdomain.com>

# Set to false only if your SMTP host serves a certificate that
# doesn't match its hostname (common on some shared hosting).
SMTP_TLS_REJECT_UNAUTHORIZED=true
