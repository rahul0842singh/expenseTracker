# ── Server ──────────────────────────────────────────────
PORT=4545
JWT_SECRET=change-me-to-a-long-random-string

# ── Database (Turso — hosted SQLite) ─────────────────────
# Get these from app.turso.tech → your database → Connect / Tokens.
# Must be a database-scoped token, not an org-level API token.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=

# ── Email / OTP delivery ──────────────────────────────────
# If unset, OTP codes are printed to the server console instead
# (useful for local dev without a real mailbox configured).
#
# Values below work for GoDaddy Workspace Email. For Gmail, use
# smtp.gmail.com / port 587 / an App Password instead of the
# regular account password.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourdomain.com
SMTP_PASS=
SMTP_FROM="ExpenseTracker" <you@yourdomain.com>

# Set to false only if your SMTP host serves a certificate that
# doesn't match its hostname (common on some shared hosting).
SMTP_TLS_REJECT_UNAUTHORIZED=true
